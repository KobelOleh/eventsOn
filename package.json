    "@emotion/styled": "11.14.1",
    "@fullcalendar/react": "7.1.2",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.7",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "temporal-polyfill": "1.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
